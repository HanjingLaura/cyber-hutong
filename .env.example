# Local / Vercel shared
HUTONG_INVITE=
HUTONG_ALLOWED_HOSTS=hanjing-laura.vercel.app
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Real offline chat replies (server only; personas in server/agent-personas/).
DASHSCOPE_API_KEY=
BAILIAN_MODEL=qwen-flash
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DAILY_LIMIT=200
LLM_DAILY_TOKEN_LIMIT=50000

# PartyKit realtime room (presence + movement)
# Shared HMAC secret between the Node/Vercel API and the PartyKit worker.
PARTY_AUTH_SECRET=
# Browser connects here (no protocol). Local: 127.0.0.1:1999  Production: <project>.<user>.partykit.dev
VITE_PARTYKIT_HOST=127.0.0.1:1999
# Optional echo for docs / health payloads
PARTYKIT_HOST=127.0.0.1:1999
PARTY_ROOM=hutong-main
