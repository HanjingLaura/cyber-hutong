# Local / Vercel shared
HUTONG_INVITE=
HUTONG_ALLOWED_HOSTS=hanjing-laura.vercel.app
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# PartyKit realtime room (presence + movement)
# Shared HMAC secret between the Node/Vercel API and the PartyKit worker.
PARTY_AUTH_SECRET=
# Browser connects here (no protocol). Local: 127.0.0.1:1999
# Production: cyber-hutong-party.<account>.workers.dev  (PartyServer on your Cloudflare account)
VITE_PARTYKIT_HOST=127.0.0.1:1999
# Optional echo for docs / health payloads
PARTYKIT_HOST=127.0.0.1:1999
PARTY_ROOM=hutong-main
