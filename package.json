{
  "name": "cyber-hutong",
  "version": "0.1.0",
  "private": true,
  "description": "赛博胡同 · hutong-online 像素平行办公室（Vite + Phaser 4，Node 后端）",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:party": "wrangler dev --port 1999",
    "deploy:party": "wrangler deploy",
    "party:secret": "wrangler secret put PARTY_AUTH_SECRET",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:moles": "node --test scripts/moles.test.mjs",
    "test:soak": "node scripts/soak.mjs",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:cloud": "node scripts/verify-turso-replica.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/functions": "^3.9.11",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "wrangler": "^4.148.0"
  }
}
