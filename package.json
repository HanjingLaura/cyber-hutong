{
  "name": "cyber-hutong",
  "version": "0.1.0",
  "private": true,
  "description": "赛博胡同 · hutong-online 像素平行办公室（Vite + Phaser 4，Node 后端）",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:party": "partykit dev --port 1999",
    "deploy:party": "partykit deploy",
    "deploy:cloudflare": "npx --yes wrangler@4.148.0 deploy",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:moles": "node --test scripts/moles.test.mjs",
    "test:soak": "node scripts/soak.mjs",
    "test:integration": "node scripts/soak-integration.mjs",
    "test:interaction-session": "node scripts/verify-interaction-session.mjs",
    "test:agents:load": "node scripts/soak-agent-load.mjs",
    "test:agents:live": "node scripts/verify-live-agent.mjs",
    "test:agents:lifecycle": "node scripts/verify-live-agent-lifecycle.mjs",
    "test:agents:browser": "node scripts/verify-live-agent-browser.mjs",
    "agents:check": "node scripts/check-agent-personas.mjs",
    "test:agents:eight-live": "node scripts/verify-eight-live-agents.mjs",
    "test:agents:preflight": "node scripts/verify-agent-preflight.mjs",
    "test:acceptance:scenes": "node scripts/verify-scene-interactions.mjs",
    "test:acceptance:recovery": "node scripts/verify-interaction-recovery.mjs",
    "test:acceptance:contention": "node scripts/verify-contention.mjs",
    "test:acceptance:shops": "node scripts/verify-shop-interactions.mjs",
    "test:acceptance:focus": "node scripts/verify-shop-interactions.mjs --focus-guards-only",
    "test:acceptance:budget": "node --test scripts/live-budget.test.mjs",
    "test:concurrency": "node --test server/concurrency.test.mjs server/party-client.test.mjs server/presence-client.test.mjs server/api-client.test.mjs server/party.test.mjs server/replica.test.mjs",
    "test:benchmark": "node scripts/compare-concurrency.mjs",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "account:reset-code": "node scripts/reset-code.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:cloud": "node scripts/verify-turso-replica.mjs",
    "test:acceptance:noodle": "node scripts/verify-noodle-social.mjs",
    "test:acceptance:coffee": "node scripts/verify-coffee-window.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/functions": "^3.9.11",
    "partykit": "^0.0.115",
    "partyserver": "0.5.10",
    "partysocket": "^1.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
